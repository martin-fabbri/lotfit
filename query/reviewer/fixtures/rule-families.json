 {
  "provision_id": "EUG.9.0500.building-height",
  "version_id": "EUG.9.0500.building-height#v1",
  "sha256": "59d050d6e4cfa2daba0054549253f6f495ee0adcf339e057f3bfb9defafe445e",
  "evaluation_stage": "definition",
  "params": [],
  "cells": [],
  "clauses": [
   {
    "clause_id": "EUG.9.0500.building-height#v1::sentence:1",
    "kind": "heading",
    "quote": "Building Height.",
    "modeled": false,
    "guards": [],
    "disposition": null,
    "needs": []
   },
   {
    "clause_id": "EUG.9.0500.building-height#v1::sentence:2",
    "kind": "sentence",
    "quote": "The vertical distance above a reference datum measured to the highest point of the coping of a flat roof, to the deck line of a mansard roof, or to the average height of the gables of a pitched or hipped roof.",
    "modeled": false,
    "guards": [],
    "disposition": null,
    "needs": [
     "plan.gable_walls",
     "plan.height_ft"
    ]
   },
   {
    "clause_id": "EUG.9.0500.building-height#v1::sentence:3",
    "kind": "sentence",
    "quote": "For the purposes of residential zones, building height shall be the vertical distance above a reference datum measured to the highest point of the roof.",
    "modeled": false,
    "guards": [],
    "disposition": null,
    "needs": [
     "plan.height_ft",
     "site.zone_family"
    ]
   },
   {
    "clause_id": "EUG.9.0500.building-height#v1::sentence:4",
    "kind": "sentence",
    "quote": "The maximum height of a stepped or terraced building is the maximum height of all segments of that building.",
    "modeled": false,
    "guards": [],
    "disposition": null,
    "needs": [
     "plan.height_ft"
    ]
   },
   {
    "clause_id": "EUG.9.0500.building-height#v1::sentence:5",
    "kind": "stem",
    "quote": "The reference datum shall be whichever of the following two measurements results in the greater building height:",
    "modeled": false,
    "guards": [],
    "disposition": null,
    "needs": []
   },
   {
    "clause_id": "EUG.9.0500.building-height#v1::item:(A)",
    "kind": "item",
    "quote": "(A) The reference datum is the lowest grade when the highest ground surface within a five-foot horizontal distance of the exterior wall of the building is not more than 10 feet above the lowest grade.",
    "modeled": false,
    "guards": [],
    "disposition": null,
    "needs": []
   },
   {
    "clause_id": "EUG.9.0500.building-height#v1::condition:(A)/when#1",
    "kind": "condition",
    "quote": "when the highest ground surface within a five-foot horizontal distance of the exterior wall of the building is not more than 10 feet above the lowest grade",
    "modeled": false,
    "guards": [],
    "disposition": null,
    "needs": []
   },
   {
    "clause_id": "EUG.9.0500.building-height#v1::item:(B)",
    "kind": "item",
    "quote": "(B) The reference datum is 10 feet higher than the lowest grade when the highest ground surface described in item (A) above is 10 feet or more above the lowest grade. (See Figure 9.0500 Building Height Calculation.)",
    "modeled": false,
    "guards": [],
    "disposition": null,
    "needs": [
