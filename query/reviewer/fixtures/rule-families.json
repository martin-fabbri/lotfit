    ]
   },
   {
    "clause_id": "EUG.9.0500.building-height#v1::condition:(B)/when#1",
    "kind": "condition",
    "quote": "when the highest ground surface described in item (A) above is 10 feet or more above the lowest grade",
    "modeled": false,
    "guards": [],
